{
  "name": "vault-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,green\" \"npm run dev -w @vault/server\" \"npm run dev -w @vault/client\"",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "concurrently": "^9.0.1",
    "jest": "^30.5.2",
    "prettier": "^3.3.3",
    "ts-jest": "^29.4.14",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "mongodb": "7.5.0"
  }
}
