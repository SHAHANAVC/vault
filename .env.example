# ==========================================
# VAULT - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to:
#   - server/.env (for Express server)
#   - client/.env.local (for Next.js client)
# ==========================================

# -----------------
# Server Configuration (server/.env)
# -----------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Atlas connection string (Replica set required for multi-document ACID transactions)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vault?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Cookie Security (false in development, true in production)
COOKIE_SECURE=false

# -----------------
# Client Configuration (client/.env.local)
# -----------------
# Public URL of the backend API (Next.js requires NEXT_PUBLIC_ prefix for client-accessible variables)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
